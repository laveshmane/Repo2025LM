package stepDefinitions;

import static org.junit.Assert.assertEquals;

import org.hamcrest.Matchers;
import static io.restassured.RestAssured.*;
import io.cucumber.java.en.Given;
import io.cucumber.java.en.Then;
import io.cucumber.java.en.When;
import io.restassured.builder.RequestSpecBuilder;
import io.restassured.builder.ResponseSpecBuilder;
import io.restassured.http.ContentType;
import io.restassured.path.json.JsonPath;
import io.restassured.specification.RequestSpecification;
import io.restassured.specification.ResponseSpecification;

public class placesStepDefinitions {
	//Request spec builder
		RequestSpecification requestSpec ;
	//Response spec bulder
	long maxTimeout = 4000;
		ResponseSpecification responseSpec; 
		RequestSpecification request;  
		
		String response;
		
	
	@Given("user adds headers and query params for {string}")
	public void user_adds_headers_and_query_params_for(String api) {
		if(api.equalsIgnoreCase("addPlace")) {
			requestSpec = new RequestSpecBuilder().setBaseUri("https://rahulshettyacademy.com/").setAccept(ContentType.JSON).addQueryParam("key", "qaclick123").build();
			request = given().spec(requestSpec).body(bdd.cucumberAPI.payload.Addplace());
		}
	}
	@When("the method is {string} and resourse is {string}")
	public void the_method_is_and_resourse_is(String method, String addPlaceResource)
	{
		if(addPlaceResource.equalsIgnoreCase("addPlace")&& method.equalsIgnoreCase("post")) {
			responseSpec = new ResponseSpecBuilder().expectStatusCode(200).expectContentType(ContentType.JSON).expectResponseTime(Matchers.lessThan(maxTimeout)).build();
			response = request.when().post("maps/api/place/add/json").then().spec(responseSpec).extract().response().asString();
		}
			}
	@Then("assert that Status code is {string}")
	public void assert_that_status_code_is (int code) {
		if(code == 200) {
			assertEquals(responseSpec.statusCode(code), code);
		}
	}
	@Then("response value {string} is {string}")
	public void response_value_is(String key, String value) {
	    JsonPath js = new JsonPath(response);
	    assertEquals(js.get(key).toString(), value);
	}
	

@Then("assert that Status code is {int}")
public void assert_that_status_code_is(Integer code) {
	if(code == 200) {
		assertEquals(responseSpec.statusCode(code), code);
	}
}


}
